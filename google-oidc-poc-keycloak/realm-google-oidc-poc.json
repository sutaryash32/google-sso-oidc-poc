{
  "realm": "google-oidc-poc",
  "enabled": true,
  "displayName": "Google Workspace OIDC POC",
  "identityProviders": [
    {
      "alias": "google-oidc",
      "displayName": "Sign in with Google Workspace (OIDC)",
      "providerId": "google",
      "enabled": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "FORCE",
        "defaultScope": "openid email profile",

        "_COMMENT_clientId": "Get from GCP Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID",
        "clientId": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID",

        "_COMMENT_clientSecret": "Get from the same OAuth 2.0 Client ID page in GCP Console",
        "clientSecret": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email-mapper",
      "identityProviderAlias": "google-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "firstname-mapper",
      "identityProviderAlias": "google-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastname-mapper",
      "identityProviderAlias": "google-oidc",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    }
  ],
  "clients": [
    {
      "clientId": "google-oidc-poc-frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false
    }
  ]
}
